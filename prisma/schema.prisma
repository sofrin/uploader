// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  runtime       = "bun"
  compilerBuild = "fast"

  }

datasource db {
  provider = "sqlite"
}

model File {
  id        String   @id
  size      Int
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  key       String   @unique
  ext       String
  name      String

  @@index([id, key])
  @@map("file")
}
